{
  "manifest_version": 3,
  "name": "Google Maps Lead Extractor & CRM Sync",
  "version": "2.0.0",
  "description": "High-Speed Google Maps Lead Extractor, Multi-Keyword Batch Scraper, and Real-Time Cloud CRM Synchronization.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Google Maps Lead Extractor & CRM Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "*://*.google.com/maps/*",
    "*://*.google.co.in/maps/*",
    "*://maps.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.trycloudflare.com/*",
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/maps/*",
        "*://*.google.co.in/maps/*",
        "*://maps.google.com/*"
      ],
      "js": [
        "content/maps-extractor.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/interceptData.js"
      ],
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.in/*",
        "*://maps.google.com/*"
      ]
    }
  ]
}