;; ============================================================================
;; PgBouncer Connection Pool Configuration for 100M+ Contacts CRM
;; File: pgbouncer.ini.example
;; ============================================================================

[databases]
crm_production = host=127.0.0.1 port=5432 dbname=crm_production auth_user=postgres

[pgbouncer]
logfile = /var/log/postgresql/pgbouncer.log
pidfile = /var/run/postgresql/pgbouncer.pid
listen_addr = 0.0.0.0
listen_port = 6432
auth_type = scram-sha-256
auth_file = /etc/pgbouncer/userlist.txt

;; Transaction pooling allows thousands of app clients with only 50-100 real PG connections
pool_mode = transaction

;; Connection Limits
max_client_conn = 10000
default_pool_size = 50
min_pool_size = 10
reserve_pool_size = 10
reserve_pool_timeout = 5
max_db_connections = 100

;; Timeouts & Performance Tuning
server_idle_timeout = 600
server_connect_timeout = 15
server_login_retry = 1
query_timeout = 60
query_wait_timeout = 120
client_idle_timeout = 0
client_login_timeout = 60

;; Low overhead logging
log_connections = 0
log_disconnections = 0
log_pooler_errors = 1
stats_period = 60

